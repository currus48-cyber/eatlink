# Base URL of the dashboard app, used to build the "Import my restaurant"
# / onboarding links from the landing page (see src/lib/dashboard-url.ts).
# Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_DASHBOARD_URL="https://app.eatlink.example"
