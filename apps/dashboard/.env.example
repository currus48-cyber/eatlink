# Copy to .env.local for development, or set these as real environment
# variables in your production host. Never commit an actual .env/.env.local
# file — see the root .gitignore.

# ── REQUIRED ──────────────────────────────────────────────────────────────

# PostgreSQL connection string (Prisma + the pg driver adapter).
DATABASE_URL="postgresql://user:password@host:5432/eatlink"

# Random secret used by Auth.js to sign session/JWT cookies. Generate with:
# openssl rand -base64 32
# NextAuth v5 refuses to start in production without this set.
AUTH_SECRET="change-me"

# Canonical URL of this app in the deployed environment (used for Auth.js
# callback URLs and as the base URL for password-reset email links — see
# src/actions/auth/forgot-password.ts, which otherwise falls back to
# http://localhost:3000 and would send broken reset links in production).
AUTH_URL="https://app.eatlink.example"

# Public base URL used to build canonical/Smart Link URLs and structured
# data (see src/lib/smart-link/metadata/site-url.ts). Falls back to
# http://localhost:3000 if unset, which is wrong for production.
NEXT_PUBLIC_SITE_URL="https://app.eatlink.example"

# Required by Auth.js whenever the app runs behind a reverse proxy / on a
# host it doesn't natively recognize (anything that isn't Vercel, which
# sets this automatically). Without it, Auth.js rejects requests with an
# "UntrustedHost" error. Set to "true".
AUTH_TRUST_HOST="true"

# ── REQUIRED for password-reset emails (not required to build/start) ──────
# The app doesn't crash at startup without these, but forgot-password
# requests will fail at send time until all four are set — see
# src/lib/email/mailer.ts.

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASSWORD="change-me"

# ── OPTIONAL ────────────────────────────────────────────────────────────

# Defaults to "EatLink <no-reply@eatlink.app>" if unset.
SMTP_FROM="EatLink <no-reply@eatlink.app>"
